# Copy to .env for local development (never commit .env).
# On Vercel, set these in Project -> Settings -> Environment Variables.
# Server-side only: do NOT add a VITE_ prefix to any of these.

# Merchant OAuth access token (app.store.authorize -> data.access_token).
# NOT the embedded ?token=. Replace it and redeploy when it expires.
SALLA_ACCESS_TOKEN=

# Salla Partners -> your app -> App Keys (not read by the code yet)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=

# Optional: prod (default) or dev
# ENV=prod

# Scan-to-Product: Google Gemini key used to draft product data from photos.
# https://aistudio.google.com/apikey  (optional GEMINI_MODEL, default gemini-2.5-flash)
# Also needs UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (or KV_REST_API_*)
# to keep QR sessions + photos across serverless invocations.
GEMINI_API_KEY=
