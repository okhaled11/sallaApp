# Copy to .env for local development (never commit .env).
# On Vercel, set these in Project -> Settings -> Environment Variables.
# Server-side only: do NOT add a VITE_ prefix to any of these.

# Merchant OAuth access token (app.store.authorize -> data.access_token).
# NOT the embedded ?token=. Replace it and redeploy when it expires.
SALLA_ACCESS_TOKEN=

# Upstash Redis (console.upstash.com -> your database -> REST API).
# Stores the cart incentives the storefront script reads.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salla Partners -> your app -> App Keys (not read by the code yet)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=

# Optional: prod (default) or dev
# ENV=prod
