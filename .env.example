# Copy to .env for `npx vercel dev`, and set the same values in
# Vercel → Project → Settings → Environment Variables (then redeploy).

# Salla Partners Portal → your app → App Keys
SALLA_APP_ID=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
# Partners Portal → your app → Webhooks → Webhook Secret
SALLA_WEBHOOK_SECRET=

# Upstash Redis — added automatically by the Vercel Marketplace integration
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Token verification environment for api/verify-token.js (prod | dev)
ENV=prod
