# Copy to .env for local development (never commit .env).
# On Vercel, set these in Project -> Settings -> Environment Variables.
# Server-side only: do NOT add a VITE_ prefix to any of these.

# Salla Partners -> your app -> App Keys
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=

# Salla Partners -> your app -> Webhooks (the secret for Signature/Token strategy)
SALLA_WEBHOOK_SECRET=

# PostgreSQL, e.g. postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Optional: prod (default) or dev
# ENV=prod
