# Copy to .env for local development (never commit .env).
# On Vercel, set these in Project -> Settings -> Environment Variables.
# Server-side only: do NOT add a VITE_ prefix to any of these.

# Merchant OAuth access token (app.store.authorize -> data.access_token).
# NOT the embedded ?token=. Replace it and redeploy when it expires.
SALLA_ACCESS_TOKEN=

# Salla Partners -> your app -> App ID. Needed by the promo popup: the
# public storefront endpoint reads the campaign from the app's App Settings.
SALLA_APP_ID=

# Salla Partners -> your app -> App Keys (not read by the code yet)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=

# Optional: prod (default) or dev
# ENV=prod
