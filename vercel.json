{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/risky-orders.js": { "maxDuration": 30 },
    "api/scan-session.js": { "maxDuration": 60 },
    "api/visual-search.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/scan-img/:token.jpg", "destination": "/api/scan-session?img=:token" }
  ],
  "headers": [
    {
      "source": "/storefront/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
